# アプリ
PORT=8787
PUBLIC_BASE_URL=https://your-public-domain.example
DEMO_MODE=true

# OpenAI（必須: 実通話・自分の声）
OPENAI_API_KEY=
OPENAI_WEBHOOK_SECRET=
OPENAI_PROJECT_ID=proj_xxxxxxxxxxxxxxxxxxxxxxxx

# Twilio（必須: 架電）
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+815012345678

# Cloudflare Workers本番管理画面のBearer認証に使用
ADMIN_TOKEN=十分に長いランダム文字列

# false にすると通話内容を保存しません
STORE_TRANSCRIPTS=true
