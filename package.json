{
  "name": "koe-ai-phone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "自分の声で電話受付・架電を行うAI電話MVP",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.mjs",
    "dev:cloudflare": "wrangler dev --local",
    "start": "node src/server.mjs",
    "test": "node --test",
    "types": "wrangler types",
    "typecheck": "wrangler types --check && tsc --noEmit",
    "deploy:dry": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply koe-ai-phone --local",
    "d1:migrate:remote": "wrangler d1 migrations apply koe-ai-phone --remote"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.123.0"
  }
}
